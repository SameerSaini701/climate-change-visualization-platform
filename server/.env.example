# Server Configuration
PORT=5000

# Google Gemini API Configuration (Optional)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
# If left blank, the dashboard will automatically provide factual insights calculated directly from NASA data.
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
